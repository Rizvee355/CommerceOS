# Required values: disabled | mock | amd-token-factory.
# Public production remains disabled until access control is separately approved.
INFERENCE_PROVIDER=disabled

# Server-only secret. Never expose with a NEXT_PUBLIC_ prefix or commit a value.
AMD_TOKEN_FACTORY_API_KEY=

# Authenticated ACT III Token Factory model used by the controlled local demo.
AMD_TOKEN_FACTORY_MODEL=DeepSeek-V4-Flash
